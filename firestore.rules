rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userData(uid) {
      return get(
        /databases/$(database)/documents/users/$(uid)
      ).data;
    }

    function isCustomer() {
      return signedIn()
        && userData(request.auth.uid).role == "customer";
    }

    function isCaptain() {
      return signedIn()
        && userData(request.auth.uid).role == "captain";
    }


    /* =========================
       USERS
       ========================= */

    match /users/{uid} {

      allow read:
        if isOwner(uid);

      allow create:
        if isOwner(uid)
        && request.resource.data.role in [
          "customer",
          "captain"
        ];

      allow update:
        if isOwner(uid)
        && request.resource.data.role ==
           resource.data.role;

      allow delete:
        if false;
    }


    /* =========================
       RIDES
       ========================= */

    match /rides/{rideId} {

      /* إنشاء الرحلة */
      allow create:
        if isCustomer()
        && request.resource.data.customerId ==
           request.auth.uid
        && request.resource.data.status == "open"
        && request.resource.data.captainId == "";


      /* قراءة الرحلات */

      allow read:
        if signedIn()
        && (
          resource.data.customerId ==
            request.auth.uid

          ||

          resource.data.captainId ==
            request.auth.uid

          ||

          (
            resource.data.status == "open"
            && isCaptain()
          )
        );


      /* العميل يعدل رحلته وهي لسه مفتوحة */

      allow update:
        if isCustomer()
        && resource.data.customerId ==
           request.auth.uid
        && resource.data.status == "open"
        && request.resource.data.customerId ==
           resource.data.customerId
        && request.resource.data.captainId ==
           resource.data.captainId;


      /* الكابتن يقبل الرحلة */

      allow update:
        if isCaptain()
        && resource.data.status == "open"
        && request.resource.data.status == "accepted"
        && request.resource.data.customerId ==
           resource.data.customerId
        && request.resource.data.captainId ==
           request.auth.uid
        && request.resource.data.captainPhone ==
           userData(request.auth.uid).phone;


      /* الكابتن يغير حالة الرحلة */

      allow update:
        if isCaptain()
        && resource.data.captainId ==
           request.auth.uid
        && request.resource.data.customerId ==
           resource.data.customerId
        && request.resource.data.captainId ==
           resource.data.captainId
        && request.resource.data.status in [
          "accepted",
          "captain_to_customer",
          "arrived",
          "started",
          "completed"
        ];


      /* حذف الرحلة */

      allow delete:
        if isCustomer()
        && resource.data.customerId ==
           request.auth.uid
        && resource.data.status == "open";
    }
  }
}
