rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, create, update: if owner(uid);
    }

    match /rides/{rideId} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.captainId == request.auth.uid ||
        resource.data.status == "open"
      );
      allow update: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.captainId == request.auth.uid
      );

      match /offers/{offerId} {
        allow read: if signedIn();
        allow create: if owner(offerId);
        allow update, delete: if owner(offerId);
      }
    }
  }
}
